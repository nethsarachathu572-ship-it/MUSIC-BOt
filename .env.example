# ==========================================
# 🌹 ROSE MUSIC BOT - CONFIGURATION
# ==========================================

# ── Discord Bot Credentials (REQUIRED) ──
BOT_TOKEN=your_discord_bot_token_here
DEFAULT_PREFIX=>
OWNER_IDS=1492423585875099719

# ── Bot Info (Optional) ──
BOT_NAME=Rose
SUPPORT_SERVER=https://discord.gg/yourserver
DATABASE_PATH=rose.db

# ── Web Dashboard Settings (Optional) ──
# Set to 'false' if your host doesn't support open ports (e.g. pure worker bot hosting)
DASHBOARD_ENABLED=true
PORT=8080
# Or DASHBOARD_PORT=8080

# ── Discord OAuth2 Dashboard Auth (Required if Dashboard is enabled) ──
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DASHBOARD_REDIRECT_URI=http://localhost:8080/auth/callback
DASHBOARD_SESSION_SECRET=generate_a_random_secret_key_here

# ── Custom Lavalink Node (Optional) ──
# If omitted, Rose will automatically use the default public Lavalink nodes in config.py
# LAVALINK_HOST=your-lavalink-server.com
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
# LAVALINK_NAME=my-node
